[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/day_summary.gd" id="1_summary"]
[ext_resource type="Script" path="res://scripts/ui/portrait_view.gd" id="2_portrait"]
[ext_resource type="Script" path="res://scripts/ui/net_worth_chart.gd" id="3_chart"]

[node name="DaySummary" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_summary")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.2, 0.14, 0.08, 0.35)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(820, 0)
layout_mode = 2
theme_type_variation = &"FeaturePanel"

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_type_variation = &"RibbonLabel"
theme_override_font_sizes/font_size = 17
text = "4月1日 周一 · 收盘结算"

[node name="Top" type="HBoxContainer" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="HeroineBox" type="VBoxContainer" parent="Center/Panel/VBox/Top"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Heroine" type="Control" parent="Center/Panel/VBox/Top/HeroineBox"]
custom_minimum_size = Vector2(150, 190)
layout_mode = 2
script = ExtResource("2_portrait")
follow_state = true

[node name="StateLabel" type="Label" parent="Center/Panel/VBox/Top/HeroineBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "平静 → 乐观"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Numbers" type="VBoxContainer" parent="Center/Panel/VBox/Top"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="PnlLabel" type="Label" parent="Center/Panel/VBox/Top/Numbers"]
unique_name_in_owner = true
layout_mode = 2
